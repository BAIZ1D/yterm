#!/usr/bin/env bash
# yterm - The Terminal YouTube Experience
# Version: 2.6.0
# Made by: BAIZID AL HAMID (cause I was bored)

# --- Strict Mode ---
set -e

VERSION="2.6.0"

# Fix CURL_CMD initialization before use
CURL_CMD="/usr/bin/curl"

# --- Version Check ---
# Check for updates against remote version (simplified)
REMOTE_VERSION_URL="https://raw.githubusercontent.com/BAIZ1D/yterm/main/VERSION"
REMOTE_VERSION=$($CURL_CMD -s "$REMOTE_VERSION_URL")

if [ -n "$REMOTE_VERSION" ] && [ "$VERSION" != "$REMOTE_VERSION" ]; then
    echo "------------------------------------------------"
    echo "UPDATE AVAILABLE: v$VERSION -> v$REMOTE_VERSION"
    echo "Please run: yterm --update"
    echo "------------------------------------------------"
fi

UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

get_real_curl() {
    if [ -f "/usr/bin/curl" ]; then echo "/usr/bin/curl"; return; fi
    if [ -f "/bin/curl" ]; then echo "/bin/curl"; return; fi
    echo "curl"
}
CURL_CMD=$(get_real_curl)

# Enhanced Stability flags for 2026/WSL 
COMMON_FLAGS="-4 --no-check-certificate --socket-timeout 10 --geo-bypass"

# --- Signal Handling ---
trap "echo -e '\nExiting yterm...'; exit 0" SIGINT SIGTERM

# --- Environment Detection ---
IS_WSL=0
if grep -qE "(Microsoft|microsoft|WSL)" /proc/version 2>/dev/null; then
    IS_WSL=1
fi

IS_MAC=0
if [[ "$(uname)" == "Darwin" ]]; then
    IS_MAC=1
    # Ensure Homebrew is in PATH for macOS
    if [ -x "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -x "/usr/local/bin/brew" ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

show_help() {
    cat << EOF
yterm v$VERSION - Search and play YouTube videos directly from your terminal.

USAGE:
    yterm start     Start the Playlist Builder menu

OPTIONS:
    -h, --help      Show this help message
    -v, --version   Show version information
    -u, --update    Full update (Engine, OS packages, and yterm script)
    -x, --uninstall Remove yterm from your system

CONTROLS:
    1. PLAYLIST BUILDER:
       - Use the menu to search, add tracks (TAB to multi-select), and start playback.

    2. DURING PLAYBACK:
       - p           : Pause/Resume.
       - q           : Skip to the next video.
       - +/-         : Volume up/down.
       - CTRL-C      : Kill playlist and exit.

EOF
}

# --- Handle Flags ---
# --- UI & MPV Helper Functions ---
send_mpv_command() {
    printf '{"command": %s}\n' "$1" | socat - "/tmp/mpv-socket-$(id -u)" >/dev/null
}

get_mpv_property() {
    local property=$1
    local response
    # Use a short timeout to prevent hanging if the socket is not ready
    response=$(printf '{"command": ["get_property", "%s"]}\n' "$property" | socat -t 0.2 - "/tmp/mpv-socket-$(id -u)" 2>/dev/null)
    
    # Check for a valid JSON response containing "data"
    if ! [[ "$response" == *"\"data\":"* ]]; then
        if [[ "$property" == "time-pos" || "$property" == "duration" || "$property" == "volume" ]]; then
            echo "0" # Return a safe numeric default
        else
            echo "false" # Return a safe boolean default
        fi
        return
    fi
    
    # Extract data if the response is valid
    local result
    result=$(echo "$response" | sed -n 's/.*"data":\([^,}]*\).*/\1/p' | sed 's/"//g')
    
    # Final safety net for numeric properties
    if [[ "$property" == "time-pos" || "$property" == "duration" || "$property" == "volume" ]]; then
        if ! [[ "$result" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
            echo "0"
        else
            echo "$result"
        fi
    else
        echo "$result"
    fi
}

draw_progress_bar() {
    local current_time=$1
    local total_time=$2
    local bar_width=40
    
    # Safety check for total_time to prevent division by zero
    if [ -z "$total_time" ] || [ "$total_time" -eq 0 ] || [ "$total_time" == "null" ]; then
        percentage=0
    else
        percentage=$((current_time * 100 / total_time))
    fi
    
    filled_width=$((bar_width * percentage / 100))
    
    bar="["
    for ((i=0; i<filled_width; i++)); do bar+="="; done
    bar+=">"
    for ((i=filled_width; i<bar_width; i++)); do bar+=" "; done
    bar+="]"
    
    printf "%s %d%%" "$bar" "$percentage"
}

format_time() {
    local total_seconds=$1
    if [[ "$total_seconds" == "null" ]] || [[ -z "$total_seconds" ]]; then
        echo "00:00"
        return
    fi
    total_seconds=${total_seconds%.*} # Remove decimals
    mins=$((total_seconds / 60))
    secs=$((total_seconds % 60))
    printf "%02d:%02d" "$mins" "$secs"
}

draw_ui() {
    local title=$1
    local current_secs_raw=$2
    local total_secs_raw=$3
    local volume=$4
    local paused=$5
    local playlist_json=$6
    local current_idx=$7
    
    # UI Width constant
    local w=60
    local b=$(printf '%*s' "$w" | tr ' ' '-')

    current_time=$(format_time "$current_secs_raw")
    total_time=$(format_time "$total_secs_raw")

    progress_bar=$(draw_progress_bar "${current_secs_raw%.*}" "${total_secs_raw%.*}")

    status_icon="▶"
    if [[ "$paused" == "true" ]]; then
        status_icon="⏸"
    fi

    # Use ANSI escape sequences for a smoother redraw
    printf "\033[H\033[J"

    # UI Design
    echo "   +${b}+"
    printf "   | %-60s |\n" "YTERM PLAYER"
    echo "   +${b}+"
    printf "   | %s %-57s |\n" "$status_icon" "${title:0:55}"
    printf "   | %s / %s  %s |\n" "$current_time" "$total_time" "$progress_bar"
    
    # ASCII Volume Bar
    vol_filled=$((volume / 10))
    vol_bar=""
    for ((i=0; i<10; i++)); do
        if [ "$i" -lt "$vol_filled" ]; then vol_bar+="|"; else vol_bar+="."; fi
    done
    printf "   | Volume: %-3d%% [%-10s]                              |\n" "$volume" "$vol_bar"
    
    echo "   +${b}+"
    echo "   | Ctrls: [p]ause | [q]skip | [+]vol up | [-]down | Ctrl+C kill |"
    echo "   +${b}+"
    printf "   | %-60s |\n" "Playlist"
    echo "   +${b}+"
    
    IFS=$'\n' read -r -d '' -a playlist_array <<< "$playlist_json"
    for i in "${!playlist_array[@]}"; do
        num=$((i+1))
        # Highlight current
        if [ "$i" -eq "$current_idx" ]; then
            printf "   | \033[1;32m> %2d. %-55s\033[0m |\n" "$num" "${playlist_array[$i]:0:50}"
        else
            printf "   |   %2d. %-55s |\n" "$num" "${playlist_array[$i]:0:50}"
        fi
    done
    echo "   +${b}+"
    }

# --- Handle Flags ---
case "$1" in
    -h|--help) show_help; exit 0 ;;
    -v|--version) echo "yterm v$VERSION"; exit 0 ;;
    -x|--uninstall)
        echo "Uninstalling yterm..."
        bash -c "$($CURL_CMD -sSL https://raw.githubusercontent.com/BAIZ1D/yterm/main/uninstall_yterm.sh)"
        exit 0
        ;;
    -u|--update)
        echo "Starting Full Update..."
        # ... (update logic unchanged)
        TOKEN="${GITHUB_TOKEN:-}"
        
        if [ $IS_MAC -eq 1 ]; then
            if command -v brew &> /dev/null; then
                echo "Updating via Homebrew..."
                brew update && brew upgrade yt-dlp fzf mpv ffmpeg node socat
            else
                echo "Error: Homebrew not found. Cannot update system packages."
            fi
        elif command -v apt &> /dev/null; then
            echo "Updating via apt..."
            sudo apt update && sudo apt install -y fzf mpv ffmpeg curl nodejs socat
            if dpkg -l | grep -q yt-dlp; then
                echo "Removing outdated apt version of yt-dlp..."
                sudo apt remove -y yt-dlp
            fi
            echo "Installing latest standalone yt-dlp..."
            sudo $CURL_CMD -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp
            sudo chmod a+rx /usr/local/bin/yt-dlp
        fi
        
        echo "Downloading latest yterm script..."
        INSTALL_DIR="$HOME/.local/bin"
        mkdir -p "$INSTALL_DIR"
        
        # Use token if available for private repo support
        if [ -n "$TOKEN" ]; then
            $CURL_CMD -sSL -H "Authorization: token $TOKEN" https://raw.githubusercontent.com/BAIZ1D/yterm/main/yterm -o "$INSTALL_DIR/yterm"
        else
            $CURL_CMD -sSL https://raw.githubusercontent.com/BAIZ1D/yterm/main/yterm -o "$INSTALL_DIR/yterm"
        fi
        
        chmod +x "$INSTALL_DIR/yterm"
        echo "Update complete! You are now on v$VERSION"
        exit 0
        ;;
    "start")
        # Continue to playlist builder
        ;;
    *)
        echo "Error: Invalid or missing command."
        echo "Use 'yterm start' to begin."
        show_help
        exit 1
        ;;
esac

# --- Dependency Check ---
check_tool() {
    if ! command -v "$1" &> /dev/null; then
        echo "Error: Required dependency '$1' is not installed."
        if [ $IS_MAC -eq 1 ]; then
            echo "Fix: brew install $1"
        else
            echo "Fix: sudo apt install $1"
        fi
        exit 1
    fi
}
check_tool "yt-dlp"
check_tool "fzf"
check_tool "mpv"
check_tool "ffmpeg"
check_tool "socat"

export YTDLP_JS_RUNTIMES="node"

# --- Playlist Builder ---
PLAYLIST_FILE="/tmp/yterm-playlist-$(id -u)"
rm -f "$PLAYLIST_FILE"

while true; do
    # Display current playlist count
    [ ! -f "$PLAYLIST_FILE" ] && touch "$PLAYLIST_FILE"
    count=$(wc -l < "$PLAYLIST_FILE" 2>/dev/null || echo 0)
    
    # Persistent Menu
    choice=$(printf "Search & Add Tracks\nView Playlist (%d)\nStart Playback\nExit" "$count" | fzf --prompt="Playlist Builder > " --height=30% --layout=reverse --border --header="Select an action")

    case "$choice" in
        "Search & Add Tracks"*)
            read -p "Enter search term: " search_term
            echo "Searching for: $search_term..."
            set +e
            results=$(yt-dlp $COMMON_FLAGS "ytsearch50:$search_term" --flat-playlist --print "%(title)s [%(id)s]")
            set -e
            
            if [ -n "$results" ]; then
                selected_list=$(echo "$results" | fzf --multi --prompt="Select video(s): " --header="TAB to multi-select, ENTER to add to playlist" --height=80% --border)
                if [ -n "$selected_list" ]; then
                    echo "$selected_list" >> "$PLAYLIST_FILE"
                fi
            else
                echo "No results found."
                sleep 1
            fi
            ;;
        "View Playlist"*)
            if [ -s "$PLAYLIST_FILE" ]; then
                set +e
                cat "$PLAYLIST_FILE" | fzf --prompt="Current Playlist (Read-only): " --height=80% --border --header="ESC to return" >/dev/null
                set -e
            else
                echo "Playlist is empty."
                sleep 1
            fi
            ;;
        "Start Playback"*)
            if [ -s "$PLAYLIST_FILE" ]; then
                selected_list=$(cat "$PLAYLIST_FILE")
                break
            else
                echo "Playlist is empty."
                sleep 1
            fi
            ;;
        "Exit"*)
            rm -f "$PLAYLIST_FILE"
            exit 0
            ;;
    esac
done

rm -f "$PLAYLIST_FILE"

# --- Media Type Selection ---
media_type=$(printf "Video\nAudio" | fzf --prompt="Select media type: " --height=15% --layout=reverse)
if [ -z "$media_type" ]; then exit 0; fi

total=$(echo "$selected_list" | wc -l)
current=0

# --- Playback Loop ---
current=0
volume=100
paused="false"

# Convert fzf output to an array for robustness
mapfile -t selected_array <<< "$selected_list"

for selected in "${selected_array[@]}"; do

    current=$((current + 1))
    video_id=$(echo "$selected" | sed "s/.*\[\(.*\)\]$/\1/")
    title=$(echo "$selected" | sed "s/ \[[^]]*\]$//")
    url="https://www.youtube.com/watch?v=$video_id"

    # --- Launch MPV for the track ---
    MPV_ARGS=()
    MPV_ARGS+=(--user-agent="$UA")
    MPV_ARGS+=(--title="yterm: $title")
    MPV_ARGS+=(--input-ipc-server="/tmp/mpv-socket-$(id -u)")
    MPV_ARGS+=(--cache=yes)
    MPV_ARGS+=(--demuxer-max-bytes=150M)

    if [ "$media_type" = "Audio" ]; then
        MPV_ARGS+=(--no-video)
        MPV_ARGS+=(--ytdl-format="bestaudio[ext=m4a]/bestaudio")
        if [ $IS_MAC -eq 1 ]; then
            MPV_ARGS+=(--really-quiet --msg-level=all=no)
        fi
    else # Video
        MPV_ARGS+=(--ytdl-format="bestvideo[ext=mp4][height<=1080]+bestaudio[ext=m4a]/best[ext=mp4]/best")
        if [ $IS_MAC -eq 1 ]; then
            MPV_ARGS+=(--hwdec=no --really-quiet --msg-level=all=no --no-terminal --no-video-osd)
        fi
    fi
    
    set +e
    # Start mpv in the background
    mpv "${MPV_ARGS[@]}" "$url" &> /dev/null &
    MPV_PID=$!
    
    # Wait a moment for mpv to initialize and create the socket
    sleep 2

    # --- "Now Playing" UI Loop ---
    while kill -0 $MPV_PID 2>/dev/null; do
        # Get properties from mpv
        time_pos=$(get_mpv_property "time-pos")
        duration=$(get_mpv_property "duration")
        paused=$(get_mpv_property "pause")
        volume_prop=$(get_mpv_property "volume")
        volume=${volume_prop%.*}
        [ -z "$volume" ] || [ "$volume" == "null" ] && volume=100

        draw_ui "[$current/$total] $title" "$time_pos" "$duration" "$volume" "$paused" "$selected_list" "$((current-1))"

        # Listen for key press
        read -rsn1 -t 0.5 key
        case "$key" in
            '+'|'=') send_mpv_command '["cycle", "volume", "up"]' ;;
            '-')      send_mpv_command '["cycle", "volume", "down"]' ;;
            'p')      send_mpv_command '["cycle", "pause"]' ;;
            'q')      kill $MPV_PID; break ;;
        esac
    done
    set -e
done

echo -e "\n\nPlaylist finished."
echo "Run 'yterm start' to begin a new session."


