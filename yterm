#!/usr/bin/env bash
# yterm - The Terminal YouTube Experience
# Version: 2.2.3
# Made by: BAIZID AL HAMID (cause I was bored)

# --- Strict Mode ---
set -e

VERSION="2.2.3"
UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Enhanced Stability flags for 2026/WSL 
# -4: Force IPv4 (Crucial for WSL network stability)
# --socket-timeout: Stop hanging if YouTube is slow
# --extractor-args: Use mobile clients which have fewer bot checks
STABILITY_FLAGS="-4 --no-check-certificate --socket-timeout 30 --extractor-args youtube:player_client=ios,android,web"

# --- Signal Handling ---
trap "echo -e '\nExiting yterm...'; exit 0" SIGINT SIGTERM

# --- WSL Detection ---
IS_WSL=0
if grep -qE "(Microsoft|microsoft|WSL)" /proc/version 2>/dev/null; then
    IS_WSL=1
fi

show_help() {
    cat << EOF
yterm v$VERSION - Search and play YouTube videos directly from your terminal.

USAGE:
    yterm [OPTIONS] "search terms"

CONTROLS:
    1. SEARCH MENU:
       - Just type   : Filter the results instantly.
       - TAB         : Select/Deselect videos to build a playlist.
       - ENTER       : Start playing.

    2. DURING PLAYBACK:
       - q           : Skip to the next video (MPV).
       - CTRL-C      : Kill everything and exit.

EOF
}

# --- Handle Flags ---
case "$1" in
    -h|--help) show_help; exit 0 ;;
    -v|--version) echo "yterm v$VERSION"; exit 0 ;;
    -u|--update)
        echo "Updating yt-dlp to latest (Nightly)..."
        sudo yt-dlp --update-to nightly || sudo yt-dlp -U
        echo "Downloading latest yterm script..."
        INSTALL_DIR="$HOME/.local/bin"
        curl -sSL https://raw.githubusercontent.com/BAIZ1D/yterm/main/yterm -o "$INSTALL_DIR/yterm"
        chmod +x "$INSTALL_DIR/yterm"
        echo "Update complete!"
        exit 0
        ;;
esac

if [ -z "$1" ]; then show_help; exit 1; fi

# --- Dependency Check ---
check_tool() {
    if ! command -v "$1" &> /dev/null; then
        echo "Error: Required dependency '$1' is not installed."
        exit 1
    fi
}
check_tool "yt-dlp"
check_tool "fzf"
check_tool "mpv"

# Ensure a JS runtime is available for YouTube's PoToken
if ! command -v node &> /dev/null && ! command -v deno &> /dev/null; then
    echo "⚠️  WARNING: No JavaScript runtime (Node.js or Deno) detected."
    echo "YouTube might block stream extraction. Install Node.js or Deno in WSL."
fi

echo "Searching YouTube for: $*..."
# shellcheck disable=SC2086
results=$(yt-dlp $STABILITY_FLAGS "ytsearch50:$*" --flat-playlist --print "%(title)s [%(id)s]" 2>/dev/null)

if [ -z "$results" ]; then
    echo "No results found. Trying one more time with different settings..."
    # shellcheck disable=SC2086
    results=$(yt-dlp -4 "ytsearch10:$*" --flat-playlist --print "%(title)s [%(id)s]" 2>/dev/null)
fi

if [ -z "$results" ]; then
    echo "Still no results. YouTube might be blocking your IP. Try 'yterm --update'."
    exit 1
fi

selected_list=$(echo "$results" | fzf --multi --prompt="Select video(s) [TAB to multi-select]: " --header="yterm - Playlist Builder (TAB to select, ENTER to play)" --height=80% --border)

if [ -z "$selected_list" ]; then exit 0; fi

total=$(echo "$selected_list" | wc -l)
current=0

echo "$selected_list" | while read -r selected; do
    current=$((current + 1))
    video_id=$(echo "$selected" | sed "s/.*\[\(.*\)\]$/\1/")
    title=$(echo "$selected" | sed "s/ \[[^]]*\]$//")

    echo "------------------------------------------------"
    echo "[$current/$total] Playing: $title"
    echo "------------------------------------------------"

    echo "Fetching stream..."
    # Force mobile client for extraction phase
    # shellcheck disable=SC2086
    stream_url=$(yt-dlp $STABILITY_FLAGS -g --user-agent "$UA" -f "best[ext=mp4][protocol^=http]" "https://www.youtube.com/watch?v=$video_id" 2>/dev/null || echo "")

    if [ -z "$stream_url" ]; then
        # shellcheck disable=SC2086
        stream_url=$(yt-dlp $STABILITY_FLAGS -g -f 18 "https://www.youtube.com/watch?v=$video_id" 2>/dev/null || echo "")
    fi

    if [ -n "$stream_url" ]; then
        if command -v typop >/dev/null 2>&1 && [ "$TERMINOLOGY" = "1" ]; then
            echo "Launching Terminology popup..."
            set +e; typop "$stream_url"; PLAY_STATUS=$?; set -e
        else
            PLAY_STATUS=1
        fi
        
        if [ $PLAY_STATUS -ne 0 ]; then
             echo "Launching MPV..."
             MPV_FLAGS="--user-agent=$UA --title=\"yterm: $title\""
             if [ $IS_WSL -eq 1 ] && [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
                 echo "No display detected. Playing Audio-Only."
                 MPV_FLAGS="$MPV_FLAGS --no-video"
             fi
             set +e
             mpv $MPV_FLAGS "$stream_url"
             set -e
        fi
    else
        echo "Error: Could not extract stream URL. Try 'yterm --update'."
    fi
done
